{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "reportId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "mode": { "type": "string", "const": "fixture" },
    "overall": { "type": "string", "enum": ["pass", "fail"] },
    "execution": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["completed", "failed"] },
        "failure": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["suite_failed", "invalid_evidence", "source_changed"]
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["status", "failure"],
      "additionalProperties": false
    },
    "methodology": {
      "type": "string",
      "const": "deterministic_application_assertions_independent_sandbox_evidence"
    },
    "source": {
      "type": "object",
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "dirty": { "type": "boolean" },
        "files": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9_./-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "dependencyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "configurationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fixtureHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": [
        "commit",
        "dirty",
        "files",
        "dependencyHash",
        "configurationHash",
        "fixtureHash"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "node": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
        "platform": {
          "type": "string",
          "enum": [
            "darwin",
            "linux",
            "win32",
            "aix",
            "freebsd",
            "openbsd",
            "sunos",
            "android",
            "haiku",
            "cygwin",
            "netbsd"
          ]
        },
        "namespaceVersion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "fixtureVersion": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        }
      },
      "required": ["node", "platform", "namespaceVersion", "fixtureVersion"],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "framework": { "type": "string", "const": "eve" },
        "version": { "type": "string", "const": "0.80.1" },
        "guardHashes": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "ownershipLeaseSeconds": { "type": "number", "const": 20 },
        "ownership": {
          "type": "string",
          "const": "single_host_os_locked_worker"
        }
      },
      "required": [
        "framework",
        "version",
        "guardHashes",
        "ownershipLeaseSeconds",
        "ownership"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "adapterVersion": { "type": "string", "const": "scripted-probe-v1" },
        "adapterHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provider": { "type": "null" },
        "providerVersion": { "type": "null" },
        "inputTokens": { "type": "null" },
        "outputTokens": { "type": "null" },
        "estimatedCost": { "type": "null" },
        "priceTableDate": { "type": "null" },
        "liveStatus": { "type": "string", "const": "not_run" }
      },
      "required": [
        "adapterVersion",
        "adapterHash",
        "provider",
        "providerVersion",
        "inputTokens",
        "outputTokens",
        "estimatedCost",
        "priceTableDate",
        "liveStatus"
      ],
      "additionalProperties": false
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,95}$" },
          "kind": {
            "type": "string",
            "enum": ["scenario", "negative_control"]
          },
          "mode": { "type": "string", "const": "fixture" },
          "status": { "type": "string", "enum": ["pass", "fail", "not_run"] },
          "sampleCount": {
            "anyOf": [
              { "type": "number", "const": 0 },
              { "type": "number", "const": 1 }
            ]
          },
          "expectedEffects": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "observedEffects": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "duplicateEffects": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "taskSuccess": { "type": ["boolean", "null"] },
          "policyViolations": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "attempts": {
            "type": "object",
            "properties": {
              "modelTurns": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "toolCalls": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "readAttempts": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "dispatchAttempts": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              }
            },
            "required": [
              "modelTurns",
              "toolCalls",
              "readAttempts",
              "dispatchAttempts"
            ],
            "additionalProperties": false
          },
          "recoveryMs": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "latencyMs": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "barrierId": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,95}$" },
              { "type": "null" }
            ]
          },
          "negativeControl": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "mutant": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,95}$"
                  },
                  "expectedViolation": {
                    "type": "string",
                    "enum": ["duplicate_effect", "unauthorized_effect"]
                  },
                  "detectorObserved": { "type": ["boolean", "null"] },
                  "baselineExitCode": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      { "type": "null" }
                    ]
                  },
                  "mutantExitCode": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      { "type": "null" }
                    ]
                  },
                  "baselineEffects": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      { "type": "null" }
                    ]
                  },
                  "mutantEffects": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      { "type": "null" }
                    ]
                  },
                  "violationCode": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,95}$"
                      },
                      { "type": "null" }
                    ]
                  },
                  "mutations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "file": {
                          "type": "string",
                          "enum": [
                            "sandbox/service.ts",
                            "agent/tools/delivery.ts"
                          ]
                        },
                        "beforeHash": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "afterHash": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "replaceCount": { "type": "number", "const": 1 }
                      },
                      "required": [
                        "file",
                        "beforeHash",
                        "afterHash",
                        "replaceCount"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "mutant",
                  "expectedViolation",
                  "detectorObserved",
                  "baselineExitCode",
                  "mutantExitCode",
                  "baselineEffects",
                  "mutantEffects",
                  "violationCode",
                  "mutations"
                ],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "failureCode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "assertion_failed",
                  "execution_failed",
                  "not_run",
                  "detector_missed",
                  "effect_mismatch",
                  "recovery_deadline_exceeded"
                ]
              },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "mode",
          "status",
          "sampleCount",
          "expectedEffects",
          "observedEffects",
          "duplicateEffects",
          "taskSuccess",
          "policyViolations",
          "attempts",
          "recoveryMs",
          "latencyMs",
          "barrierId",
          "negativeControl",
          "failureCode"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "catalogCases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executedSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passedCases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedCases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notRunCases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scenarioSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "negativeControlSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effectsMeasuredSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policyMeasuredSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recoveryMeasuredSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latencyMeasuredSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "catalogCases",
        "executedSamples",
        "passedCases",
        "failedCases",
        "notRunCases",
        "scenarioSamples",
        "negativeControlSamples",
        "effectsMeasuredSamples",
        "policyMeasuredSamples",
        "recoveryMeasuredSamples",
        "latencyMeasuredSamples"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "reportId",
    "generatedAt",
    "mode",
    "overall",
    "execution",
    "methodology",
    "source",
    "environment",
    "runtime",
    "model",
    "cases",
    "summary"
  ],
  "additionalProperties": false
}
