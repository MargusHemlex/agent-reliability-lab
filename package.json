{
  "name": "agent-reliability-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Synthetic delivery workflow with durable execution, bound approval and an independent idempotent sandbox",
  "license": "MIT",
  "dependencies": {
    "ai": "7.0.143",
    "eve": "0.80.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "EVE_TELEMETRY_DISABLED=1 eve build --skip-sandbox-prewarm",
    "spike": "node spike/run.mjs",
    "test": "node --test spike/model.test.mjs test/*.test.mjs",
    "format": "prettier --check agent sandbox lab test evaluation fixtures spike/*.mjs package.json tsconfig.json",
    "format:write": "prettier --write agent sandbox lab test evaluation fixtures spike/*.mjs package.json tsconfig.json",
    "spike:overlap": "node spike/overlap.mjs",
    "spike:ownership": "node spike/ownership.mjs",
    "lab": "node lab/cli.mjs",
    "test:workflow": "node test/workflow.mjs",
    "test:milestone3": "node test/milestone3.mjs",
    "evaluate": "node test/evaluate.mjs",
    "test:adverse": "node test/evaluation.mjs",
    "test:negative": "node test/negative-controls.mjs",
    "reports:schema": "node evaluation/schema.mjs",
    "reports:validate": "node evaluation/validate.mjs",
    "reports:live-schema": "node evaluation/live-schema.mjs",
    "reports:live-validate": "node evaluation/live-validate.mjs",
    "test:live": "node --test test/live*.test.mjs",
    "evaluate:live": "node test/live-smoke.mjs",
    "test:live-workflow": "node test/live-workflow.mjs"
  }
}
