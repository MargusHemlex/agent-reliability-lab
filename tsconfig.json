{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "allowImportingTsExtensions": true
  },
  "include": ["agent/**/*.ts", "sandbox/**/*.ts", "lab/**/*.ts"]
}
